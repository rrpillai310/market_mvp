# Alpha Vantage (free tier: https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=your_key_here

# ── LLM provider ─────────────────────────────────────────────────────────────
# Set to "ollama" (default) or "claude"
LLM_PROVIDER=ollama

# Ollama on DGX Spark
OLLAMA_HOST=http://spark-1dca.local:11434
OLLAMA_MODEL=qwen2.5:72b
OLLAMA_MODEL_REASONING=deepseek-r1:70b

# Claude / Anthropic (used when LLM_PROVIDER=claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here
# Model for extraction calls (default: claude-opus-4-7)
CLAUDE_MODEL=claude-opus-4-7
# Model for reasoning calls like Fed minutes analysis (default: same as CLAUDE_MODEL)
# CLAUDE_MODEL_REASONING=claude-opus-4-7

# Reddit API (free: https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=market_mvp/1.0

# ── Storage paths (Mac defaults work out of the box; override for AWS) ────────
# Path to the directory containing market_mvp.duckdb
# Default: ../data/ relative to the repo root
# DATA_DIR=/data

# Path to the directory where models are saved
# Default: ../models/ relative to the repo root
# MODELS_DIR=/models

# ── AWS S3 sync (leave blank when running on Mac) ─────────────────────────────
# When set, the pipeline syncs data/ and models/ to/from this S3 bucket
# before and after each run, providing durability across EC2 stop/start.
# S3_BUCKET=my-market-mvp-bucket
